Panels:
  - Class: rviz/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /Current Cloud1
        - /grid_map_cloud1
        - /Icp Cloud1
        - /predict_pose1
        - /predicted_pose1
        - /icp_location_pose1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 1223
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Expanded: ~
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
