<launch>
  <!-- 仅测试 data_preprocess 读入：加载 data 文件并做 ROS_INFO 打印，不跑 SLAM、不启动 rviz -->
  <arg name="data_file" default="$(find laster_slam_2d)/data/pose_log.txt"/>

  <node pkg="laster_slam_2d"
        type="test_data_load"
        name="test_data_load"
        output="screen"
        args="$(arg data_file)"/>
</launch>