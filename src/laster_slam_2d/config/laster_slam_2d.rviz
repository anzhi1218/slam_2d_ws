Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /Current Cloud1
        - /grid_map_cloud1
        - /Icp Cloud1
        - /predict_pose1
        - /predicted_pose1
        - /icp_location_pose1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 400
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    # 1. 网格
    - Alpha: 0.3
      Cell Size: 1
      Class: rviz/Grid
      Color: 128; 128; 128
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true

    # 2. 栅格地图：白色=已构建区域，灰色=未探索区域
    - Alpha: 1
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: Map
      Topic: /map
      Value: true


    # 4. 当前帧点云（红色，仅当前帧）
    - Alpha: 1
      Class: rviz/PointCloud2
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Current Cloud
      Size (Pixels): 4
      Size (m): 0.015
      Style: Points
      Topic: /laster_slam_2d/current_cloud
      Value: true

    # grid_map_cloud（绿色，累积地图点云）
    - Alpha: 1
      Class: rviz/PointCloud2
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: grid_map_cloud
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic: /laster_slam_2d/grid_map_cloud
      Value: true

    # 5. icp_cloud（蓝色，仅当前帧）
    - Alpha: 1
      Class: rviz/PointCloud2
      Color: 0; 0; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Icp Cloud
      Size (Pixels): 4
      Size (m): 0.015
      Style: Points
      Topic: /laster_slam_2d/icp_cloud
      Value: true

    # 轨迹 1：predict_pose（data.txt 先验，蓝色，默认不显示）
    - Alpha: 1
      Class: rviz/Path
      Color: 30; 144; 255
      Enabled: false          # 不启用，仅保留配置
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: predict_pose
      Topic: /laster_slam_2d/predict_path
      Value: false

    # 轨迹 2：predicted_pose（橙色）
    - Alpha: 1
      Class: rviz/Path
      Color: 255; 165; 0
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: predicted_pose
      Topic: /laster_slam_2d/predicted_path
      Value: true

    # 轨迹 3：icp_location_pose（ICP配准后的pose，绿色）
    - Alpha: 1
      Class: rviz/Path
      Color: 0; 200; 83
      Enabled: true
      Line Style:
        Line Width: 0.04
        Value: Lines
      Name: icp_location_pose
      Topic: /laster_slam_2d/location_path
      Value: true

    # 7. TF 坐标系
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Tree: {}
      Value: true

  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Fixed Frame: map
    Frame Rate: 30

  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal

  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 40
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.5
    Saved: ~ //laster_slam_2d.rviz